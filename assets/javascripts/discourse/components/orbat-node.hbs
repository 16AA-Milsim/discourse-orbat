{{! template-lint-disable require-strict-mode}}
<div
  class={{this.wrapperClass}}
  data-orbat-code={{@node.code}}
  data-orbat-level={{@node.level}}
>
  {{#if this.shouldShowHeader}}
    <header
      class={{concat "orbat-node__header" (if this.hasIcon " orbat-node__header--with-icon" "")}}
    >
      {{#if this.hasBadge}}
        {{#if this.shouldTintBadge}}
          <span
            class="orbat-node__badge-wrap"
            style={{this.badgeMaskStyle}}
            aria-hidden="true"
          >
            <img
              class={{this.badgeSourceClass}}
              src={{this.badge}}
              style={{this.badgeStyle}}
              alt=""
              aria-hidden="true"
            />
            <span
              class="orbat-node__badge--tint"
              aria-hidden="true"
            ></span>
          </span>
        {{else}}
          <img
            class={{this.badgeClass}}
            src={{this.badge}}
            style={{this.badgeStyle}}
            alt=""
            aria-hidden="true"
          />
        {{/if}}
      {{/if}}
      <div class="orbat-node__title">
        {{#if this.hasIcon}}
          {{#if this.shouldTintIcon}}
            <span class="orbat-node__icon-wrap" style={{this.iconMaskStyle}}>
              <img
                class={{this.iconSourceClass}}
                src={{this.icon}}
                alt={{@node.label}}
              />
              <span class="orbat-node__icon--tint" aria-hidden="true"></span>
            </span>
          {{else}}
            <img
              class={{this.iconClass}}
              src={{this.icon}}
              alt={{@node.label}}
            />
          {{/if}}
        {{/if}}
        <h3
          class="orbat-node__label"
          style={{this.labelContainerStyle}}
        >
          <span
            class="orbat-node__label-text"
            style={{this.labelTextStyle}}
            {{did-insert this.registerLabelText}}
            {{did-update this.refreshLabelText @node.label this.hasIcon this.labelFontSize}}
            {{will-destroy this.unregisterLabelText}}
          >
            {{@node.label}}
          </span>
        </h3>
      </div>
    </header>
  {{/if}}

  {{#unless this.isNodeHidden}}
    <div class="orbat-node__card">
      {{#if @node.description}}
        <p class="orbat-node__description">
          {{@node.description}}
        </p>
      {{/if}}

      {{#if this.hasUsers}}
        <div
          class="orbat-node__users"
          {{did-insert this.registerUsersContainer}}
          {{did-update this.refreshUsersContainer this.users.length this.uniformHoverPreviewEnabled}}
          {{will-destroy this.unregisterUsersContainer}}
        >
          {{#each this.userColumns as |column|}}
            <ul class="orbat-node__users-column">
              {{#each column as |user|}}
                <li
                  class={{concat "orbat-node__user" (if (this.isUniformPreviewActive user) " orbat-node__user--uniform-preview-active" "")}}
                  data-uniform-preview-key={{this.uniformPreviewKey user}}
                  {{on "mouseenter" (fn this.handleUserHoverEnter user)}}
                  {{on "mouseleave" (fn this.handleUserHoverLeave user)}}
                  {{on "focusin" (fn this.handleUserHoverEnter user)}}
                  {{on "focusout" (fn this.handleUserHoverLeave user)}}
                  {{on "pointerdown" (fn this.handleUserPointerDown user)}}
                  {{on "mousedown" (fn this.handleUserMouseDown user)}}
                >
                  {{#if this.showAvatars}}
                    <UserAvatar
                      @user={{user}}
                      @size="small"
                      class="orbat-node__avatar"
                    />
                  {{/if}}
                  <a
                    href={{or user.summaryPath user.profilePath user.path}}
                    class="orbat-node__user-link"
                    {{on "click" (fn this.openSummary user)}}
                  >
                    {{this.formatDisplayName user}}
                  </a>

                  {{#if (this.isUniformPreviewVisible user)}}
                    <span
                      class={{this.uniformPreviewClass user}}
                      style={{this.uniformPreviewStyle user}}
                      role="tooltip"
                      {{did-insert this.registerUniformPreviewElement user}}
                      {{did-update this.updateUniformPreviewElement user (this.isUniformPreviewLoaded user) (this.uniformPreviewHasAdditionalQualifications user)}}
                      {{will-destroy this.unregisterUniformPreviewElement user}}
                    >
                      {{#if (this.isUniformPreviewLoaded user)}}
                        <img
                          class="orbat-node__uniform-preview-image"
                          src={{this.uniformPreviewUrl user}}
                          alt={{this.uniformPreviewAlt user}}
                          loading="lazy"
                          decoding="async"
                        />
                        <span class="orbat-node__uniform-preview-title">
                          {{this.uniformPreviewDisplayName user}}
                        </span>

                        {{#if (this.uniformPreviewHasAdditionalQualifications user)}}
                          <span class="orbat-node__uniform-preview-quals-title">
                            {{this.uniformPreviewQualificationsTitle user}}
                          </span>
                          <span class="orbat-node__uniform-preview-quals">
                            {{#each (this.uniformPreviewAdditionalQualificationRows user) as |row|}}
                              <span class="orbat-node__uniform-preview-quals-row">
                                {{#each row as |qualification|}}
                                  <span class="orbat-node__uniform-preview-qual">
                                    {{#if qualification.imageUrl}}
                                      <img
                                        class="orbat-node__uniform-preview-qual-image"
                                        src={{qualification.imageUrl}}
                                        alt={{qualification.name}}
                                        loading="lazy"
                                        decoding="async"
                                      />
                                    {{/if}}
                                    <span class="orbat-node__uniform-preview-qual-name">
                                      {{qualification.name}}
                                    </span>
                                  </span>
                                {{/each}}
                              </span>
                            {{/each}}
                          </span>
                        {{/if}}
                      {{else}}
                        <span class="orbat-node__uniform-preview-loading">
                          <span class="orbat-node__uniform-preview-spinner" aria-hidden="true"></span>
                          <span class="orbat-node__uniform-preview-loading-text">
                            {{i18n "orbat.node.uniform_preview_loading"}}
                          </span>
                        </span>
                      {{/if}}
                    </span>
                  {{/if}}
                </li>
              {{/each}}
            </ul>
          {{/each}}
        </div>
      {{else if this.showPlaceholder}}
        <div class="orbat-node__placeholder">
          {{this.placeholderText}}
        </div>
      {{/if}}
    </div>
  {{/unless}}

</div>
