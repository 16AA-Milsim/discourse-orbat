{{#if this.disallow}}
  <div class="orbat-empty">
    {{i18n "admin.site_settings.only_admins"}}
  </div>
{{else}}
  <div class="orbat-admin">
    <header class="orbat-banner">
      <div class="orbat-banner__text">
        <h1 class="orbat-banner__title">
          {{i18n "orbat_admin.title"}}
        </h1>
        <p class="orbat-banner__subtitle">
          {{i18n "orbat_admin.description"}}
        </p>
      </div>
    </header>

    <div class="orbat-admin__settings">
      <label class="orbat-setting">
        <span class="orbat-setting__label">
          {{i18n "orbat_admin.settings.enabled"}}
        </span>
        <Input
          @type="checkbox"
          @checked={{this.orbatEnabled}}
          @disabled={{this.updatingEnabled}}
          {{on "change" this.updateOrbatEnabled}}
        />
      </label>
      <label class="orbat-setting">
        <span class="orbat-setting__label">
          {{i18n "orbat_admin.settings.admin_only"}}
        </span>
        <Input
          @type="checkbox"
          @checked={{this.orbatAdminOnly}}
          @disabled={{this.adminOnlyDisabled}}
          {{on "change" this.updateOrbatAdminOnly}}
        />
      </label>
      <div class="orbat-setting orbat-setting--field">
        <div class="orbat-setting__label">
          {{i18n "orbat_admin.settings.exclusive_groups_label"}}
        </div>
        <div class="orbat-setting__field">
          <Input
            @type="text"
            @value={{this.orbatExclusiveGroups}}
            @placeholder={{i18n "orbat_admin.settings.exclusive_groups_placeholder"}}
            @disabled={{this.updatingExclusiveGroups}}
            {{on "input" this.updateExclusiveGroupsInput}}
          />
          <DButton
            @label="orbat_admin.settings.exclusive_groups_save"
            @action={{this.saveExclusiveGroups}}
            @disabled={{this.exclusiveGroupsSaveDisabled}}
            class="btn-default btn-small"
          />
        </div>
        <div class="orbat-setting__help">
          {{i18n "orbat_admin.settings.exclusive_groups_help"}}
        </div>
      </div>
      <div class="orbat-setting orbat-setting--field">
        <div class="orbat-setting__label">
          {{i18n "orbat_admin.settings.exclusive_groups_passthrough_label"}}
        </div>
        <div class="orbat-setting__field">
          <Input
            @type="text"
            @value={{this.orbatExclusiveGroupsPassthrough}}
            @placeholder={{i18n "orbat_admin.settings.exclusive_groups_passthrough_placeholder"}}
            @disabled={{this.updatingExclusiveGroupsPassthrough}}
            {{on "input" this.updateExclusiveGroupsPassthroughInput}}
          />
          <DButton
            @label="orbat_admin.settings.exclusive_groups_passthrough_save"
            @action={{this.saveExclusiveGroupsPassthrough}}
            @disabled={{this.exclusiveGroupsPassthroughSaveDisabled}}
            class="btn-default btn-small"
          />
        </div>
        <div class="orbat-setting__help">
          {{i18n "orbat_admin.settings.exclusive_groups_passthrough_help"}}
        </div>
      </div>
    </div>

    <div class="orbat-admin__layout">
      <section class="orbat-admin__editor">
        {{#if this.isLoaded}}
          <Form
            @data={{this.data}}
            @onSubmit={{this.save}}
            @onRegisterApi={{this.registerFormApi}}
            @validate={{this.validateDraft}}
            as |form|
          >
            <form.Container
              @title={{i18n "orbat_admin.editor.heading"}}
              @subtitle={{i18n "orbat_admin.editor.instructions"}}
            >
              <details class="orbat-admin__guide">
                <summary>{{i18n "orbat_admin.editor.guide_summary"}}</summary>
                <div class="orbat-admin__guide-body">
                  <p>
                    Build the ORBAT by combining top-level metadata with a
                    <code>nodes</code> array. Each node can resolve members from
                    Discourse groups and nest children to create the tree. The
                    only required pieces are <code>nodes</code> and a
                    <code>label</code> for each node.
                  </p>

                  <h4>Top-level keys</h4>
                  <ul class="orbat-admin__guide-list">
                    <li>
                      <code>title</code> and <code>subtitle</code> drive the
                      masthead text.
                    </li>
                    <li>
                      <code>display</code> controls global behaviour (spacing,
                      columns, empty placeholders, etc.).
                    </li>
                    <li>
                      <code>rankPriority</code> defines how ranks are ordered
                      within each role bucket.
                    </li>
                    <li>
                      <code>nodes</code> is an array of unit definitions; the
                      order you provide is preserved on the root level unless you
                      group them via <code>display.rootSections</code>.
                    </li>
                    <li>
                      <code>banner</code> is reserved for custom themes and is
                      not rendered by the default ORBAT page.
                    </li>
                  </ul>

                  <h4>Display options</h4>
                  <dl class="orbat-admin__guide-dl">
                    <dt><code>showEmpty</code></dt>
                    <dd>
                      Keep empty units in the tree. When false, empty nodes are
                      pruned unless <code>alwaysShow</code> is true on the node.
                    </dd>
                    <dt><code>emptyLabel</code></dt>
                    <dd>
                      Fallback placeholder text when a node has no members.
                    </dd>
                    <dt><code>showAvatars</code></dt>
                    <dd>
                      Show user avatars next to names.
                    </dd>
                    <dt><code>maxPerColumn</code></dt>
                    <dd>
                      Maximum users per column before wrapping.
                    </dd>
                    <dt><code>rootLayout</code></dt>
                    <dd>
                      <code>"row"</code> (default) or <code>"column"</code>; sets
                      how top-level nodes are laid out.
                    </dd>
                    <dt><code>rootSections</code></dt>
                    <dd>
                      Optional array to add headings and custom layouts for code
                      prefixes. Each entry supports:
                      <code>prefixes</code> (or <code>prefix</code>/<code>codes</code>),
                      <code>title</code>, <code>subtitle</code>,
                      <code>description</code>, <code>layout</code> (with
                      <code>type</code>, <code>columns</code>, <code>gap</code>),
                      <code>showEmpty</code>, and <code>emptyLabel</code>.
                    </dd>
                    <dt><code>tintExcludeSvgs</code></dt>
                    <dd>
                      Array of SVG filenames to skip tinting. Defaults to
                      <code>["16th_air_assault.svg"]</code>. Set to
                      <code>[]</code> to allow tinting every SVG.
                    </dd>
                  </dl>
                  <p>
                    Note: <code>display.gap</code>, <code>display.rootColumns</code>,
                    and <code>display.hideGroupLinks</code> are not used by the
                    default ORBAT UI, but are kept for custom themes.
                  </p>

                  <h4>Node structure</h4>
                  <p>
                    Each node should have a unique <code>code</code>;
                    <code>id</code> is recommended. If omitted, they are derived
                    from <code>label</code>. Dots inside the code (for example
                    <code>"1.2.3"</code>) help establish parent/child
                    relationships. Common properties include:
                  </p>
                  <ul class="orbat-admin__guide-list">
                    <li><code>label</code>: visible title for the unit (required).</li>
                    <li><code>description</code>: optional body text.</li>
                    <li>
                      <code>theme</code>: optional styling token (e.g.
                      <code>"company"</code>, <code>"platoon"</code>).
                    </li>
                    <li>
                      <code>badge</code> and <code>icon</code>: image paths or
                      URLs. Relative paths resolve to this plugin's
                      <code>public/images</code> directory.
                    </li>
                    <li>
                      <code>badgeTint</code>/<code>iconTint</code> (true/false)
                      apply the theme palette to SVG assets; set to
                      <code>false</code> to keep original SVG colors.
                      <code>badgeFilter</code>/<code>iconFilter</code> control
                      whether PNG filters/opacity are applied.
                    </li>
                    <li>
                      <code>badgeWidth</code>, <code>labelFontSize</code>,
                      <code>marginLeft</code>, and <code>marginRight</code>:
                      numeric pixel values (negative values reduce spacing).
                    </li>
                    <li>
                      <code>select</code>: resolves users. Use
                      <code>any</code>, <code>all</code>, <code>not</code>,
                      <code>limit</code>, <code>includeHidden</code>,
                      <code>placeholder</code>. Group names must match
                      Discourse group names.
                    </li>
                    <li>
                      <code>children</code>: array of nested nodes using the same
                      structure.
                    </li>
                    <li>
                      <code>alwaysShow</code> or <code>hideNode</code> to force
                      visibility or suppress the card while leaving connectors.
                    </li>
                  </ul>
                  <p>
                    Ordering is fixed: members are listed by role first
                    (<code>Coy_IC</code>, then <code>Coy_2IC</code>, then other
                    <code>*_IC</code>, then other <code>*_2IC</code>, then
                    regular members), then by <code>rankPriority</code>, then by
                    join date (manual 16AA Join Date if set, otherwise forum join
                    date), then alphabetically by username.
                  </p>
                  <p>
                    <code>layout</code> on nodes is accepted and preserved in the
                    JSON output, but the default ORBAT UI does not currently use
                    it.
                  </p>

                  <h4>Example template</h4>
                  <pre class="orbat-admin__guide-code"><code class="lang-json">{
  "title": "ORBAT",
  "subtitle": "Example Unit",
  "banner": {
    "logo": "images/common/16th_air_assault.svg",
    "title": "Banner Title",
    "subtitle": "Banner Subtitle",
    "background": "#0b1220",
    "accent": "#f59e0b"
  },
  "display": {
    "showEmpty": true,
    "emptyLabel": "-",
    "showAvatars": false,
    "maxPerColumn": 8,
    "rootLayout": "row",
    "rootColumns": 3,
    "gap": "md",
    "hideGroupLinks": true,
    "rootSections": [
      {
        "prefixes": ["1"],
        "title": "Line Units",
        "subtitle": "Main force",
        "description": "Primary combat elements.",
        "layout": {
          "type": "row",
          "columns": 2,
          "gap": "sm"
        },
        "showEmpty": true,
        "emptyLabel": "TBD"
      },
      {
        "codes": ["2"],
        "title": "Support",
        "subtitle": "Enablers",
        "description": "Specialist detachments.",
        "layout": {
          "type": "column",
          "columns": 1,
          "gap": "lg"
        },
        "showEmpty": false,
        "emptyLabel": "-"
      }
    ]
  },
  "rankPriority": [
    "Major",
    "Captain",
    "Lieutenant",
    "Sergeant",
    "Corporal",
    "Private"
  ],
  "nodes": [
    {
      "id": "coy-hq",
      "code": "1",
      "label": "Company HQ",
      "description": "Command element.",
      "theme": "company",
      "badge": "ab_inf_coy.svg",
      "badgeWidth": 46,
      "icon": "hq.png",
      "labelFontSize": 9,
      "marginLeft": 6,
      "marginRight": 6,
      "select": {
        "any": ["Coy_IC", "Coy_2IC", "Coy"],
        "not": ["LeaveOfAbsence"],
        "limit": 5,
        "includeHidden": false,
        "placeholder": "Vacant"
      },
      "layout": {
        "type": "row",
        "columns": 2,
        "gap": "sm",
        "align": "center"
      },
      "alwaysShow": true,
      "children": [
        {
          "id": "platoon-1",
          "code": "1.1",
          "label": "1 Platoon HQ",
          "theme": "platoon",
          "badge": "ab_inf_pl.svg",
          "icon": "red_hq.png",
          "select": {
            "all": ["1_Platoon"]
          },
          "layout": {
            "type": "column",
            "align": "center"
          },
          "children": [
            {
              "id": "section-a",
              "code": "1.1.1",
              "label": "1/1 Section",
              "theme": "section",
              "badge": "ab_inf_sec.svg",
              "icon": "red_1.png",
              "select": {
                "any": ["1-1_Section_IC", "1-1_Section_2IC", "1-1_Section"],
                "includeHidden": true
              },
              "layout": {
                "type": "column",
                "align": "center"
              },
              "alwaysShow": true
            }
          ]
        }
      ]
    },
    {
      "id": "attachments",
      "code": "2",
      "label": "Attachments",
      "theme": "support",
      "badge": "atts_coy.svg",
      "hideNode": true,
      "select": {
        "any": ["Attachments"]
      },
      "layout": {
        "type": "column",
        "align": "center"
      },
      "children": [
        {
          "id": "joint-helicopter-command",
          "code": "2.1",
          "label": "Joint Helicopter Command",
          "theme": "section",
          "badge": "rot_wing_coy.svg",
          "icon": "JHC.png",
          "select": {
            "any": ["JHC_IC", "JHC_2IC", "JHC"]
          },
          "layout": {
            "type": "column",
            "align": "center"
          },
          "alwaysShow": true
        }
      ]
    }
  ]
}</code></pre>

                  <p>
                    Use the preview action after edits to validate JSON syntax
                    and ensure every referenced group exists or is visible to the
                    resolver.
                  </p>
                </div>
              </details>

              <form.Field
                @name="configuration"
                @title={{i18n "orbat_admin.editor.heading"}}
                @description={{i18n "orbat_admin.editor.help"}}
                @format="full"
                as |field|
              >
                <field.Code @lang="javascript" @height={{420}} />
              </form.Field>

              {{#if this.allWarnings.length}}
                <div class="alert alert-warning orbat-admin__validation">
                  <div class="orbat-admin__validation-title">
                    {{i18n "orbat_admin.validation.heading"}}
                  </div>
                  <div class="orbat-admin__validation-help">
                    {{i18n "orbat_admin.validation.help"}}
                  </div>
                  <ul class="orbat-admin__validation-list">
                    {{#each this.allWarnings as |warning|}}
                      <li>{{warning}}</li>
                    {{/each}}
                  </ul>
                </div>
              {{/if}}
            </form.Container>

            <form.Actions>
              <form.Submit @label="orbat_admin.actions.save" />
              <form.Button
                @label="orbat_admin.actions.preview_orbat"
                @type="button"
                class="btn-secondary"
                @action={{this.generatePreview}}
              />
              <form.Button
                @label="orbat_admin.actions.restore_default"
                @type="button"
                class="btn-danger"
                @action={{this.restoreDefault}}
              />
            </form.Actions>
          </Form>

          {{#if this.notice}}
            <div class="alert alert-info">
              {{this.notice}}
            </div>
          {{/if}}
        {{else}}
          <ConditionalLoadingSpinner @size="medium" />
        {{/if}}
      </section>

      <section class="orbat-admin__preview">
        <h2 class="orbat-admin__preview-heading">
          {{i18n "orbat_admin.preview.heading"}}
        </h2>
        {{#if this.isLoaded}}
          {{#if (eq this.previewState "loading")}}
            <ConditionalLoadingSpinner @size="medium" />
          {{else if this.previewTree}}
            <OrbatTree @tree={{this.previewTree}} />
          {{else}}
            <p class="orbat-admin__indicator">
              {{i18n "orbat_admin.preview.unavailable"}}
            </p>
          {{/if}}
        {{else}}
          <ConditionalLoadingSpinner @size="medium" />
        {{/if}}
      </section>
    </div>
  </div>
{{/if}}
