{{#if this.disallow}}
  <div class="orbat-empty">
    {{i18n "admin.site_settings.only_admins"}}
  </div>
{{else}}
  <div class="orbat-admin">
    <header class="orbat-banner">
      <div class="orbat-banner__text">
        <h1 class="orbat-banner__title">
          {{i18n "orbat_admin.title"}}
        </h1>
        <p class="orbat-banner__subtitle">
          {{i18n "orbat_admin.description"}}
        </p>
      </div>
    </header>

    <div class="orbat-admin__settings">
      <label class="orbat-setting">
        <span class="orbat-setting__label">
          {{i18n "orbat_admin.settings.enabled"}}
        </span>
        <Input
          @type="checkbox"
          @checked={{this.orbatEnabled}}
          @disabled={{this.updatingEnabled}}
          {{on "change" this.updateOrbatEnabled}}
        />
      </label>
      <label class="orbat-setting">
        <span class="orbat-setting__label">
          {{i18n "orbat_admin.settings.admin_only"}}
        </span>
        <Input
          @type="checkbox"
          @checked={{this.orbatAdminOnly}}
          @disabled={{this.adminOnlyDisabled}}
          {{on "change" this.updateOrbatAdminOnly}}
        />
      </label>
    </div>

    <div class="orbat-admin__layout">
      <section class="orbat-admin__editor">
        {{#if this.isLoaded}}
          <Form
            @data={{this.data}}
            @onSubmit={{this.save}}
            @onRegisterApi={{this.registerFormApi}}
            @validate={{this.validateDraft}}
            as |form|
          >
            <form.Container
              @title={{i18n "orbat_admin.editor.heading"}}
              @subtitle={{i18n "orbat_admin.editor.instructions"}}
            >
              <details class="orbat-admin__guide">
                <summary>{{i18n "orbat_admin.editor.guide_summary"}}</summary>
                <div class="orbat-admin__guide-body">
                  <p>
                    Build the ORBAT by combining top-level metadata with a
                    <code>nodes</code> array. Each node can resolve members from
                    Discourse groups and nest children to create the tree. The
                    only required pieces are <code>nodes</code> and a
                    <code>label</code> for each node.
                  </p>

                  <h4>Top-level keys</h4>
                  <ul class="orbat-admin__guide-list">
                    <li>
                      <code>title</code> and <code>subtitle</code> drive the
                      masthead text.
                    </li>
                    <li>
                      <code>display</code> controls global behaviour (spacing,
                      columns, empty placeholders, etc.).
                    </li>
                    <li>
                      <code>rankPriority</code> defines how ranks are ordered
                      within a group.
                    </li>
                    <li>
                      <code>nodes</code> is an array of unit definitions; the
                      order you provide is preserved on the root level unless you
                      group them via <code>display.rootSections</code>.
                    </li>
                    <li>
                      <code>banner</code> is reserved for custom themes and is
                      not rendered by the default ORBAT page.
                    </li>
                  </ul>

                  <h4>Display options</h4>
                  <dl class="orbat-admin__guide-dl">
                    <dt><code>showEmpty</code></dt>
                    <dd>
                      Keep empty units in the tree. When false, empty nodes are
                      pruned unless <code>alwaysShow</code> is true on the node.
                    </dd>
                    <dt><code>emptyLabel</code></dt>
                    <dd>
                      Fallback placeholder text when a node has no members.
                    </dd>
                    <dt><code>showAvatars</code></dt>
                    <dd>
                      Show user avatars next to names.
                    </dd>
                    <dt><code>maxPerColumn</code></dt>
                    <dd>
                      Maximum users per column before wrapping.
                    </dd>
                    <dt><code>rootLayout</code></dt>
                    <dd>
                      <code>"row"</code> (default) or <code>"column"</code>; sets
                      how top-level nodes are laid out.
                    </dd>
                    <dt><code>rootSections</code></dt>
                    <dd>
                      Optional array to add headings and custom layouts for code
                      prefixes. Each entry supports:
                      <code>prefixes</code> (or <code>prefix</code>/<code>codes</code>),
                      <code>title</code>, <code>subtitle</code>,
                      <code>description</code>, <code>layout</code> (with
                      <code>type</code>, <code>columns</code>, <code>gap</code>),
                      <code>showEmpty</code>, and <code>emptyLabel</code>.
                    </dd>
                  </dl>
                  <p>
                    Note: <code>display.gap</code>, <code>display.rootColumns</code>,
                    and <code>display.hideGroupLinks</code> are not used by the
                    default ORBAT UI, but are kept for custom themes.
                  </p>

                  <h4>Node structure</h4>
                  <p>
                    Each node should have a unique <code>code</code>;
                    <code>id</code> is recommended. If omitted, they are derived
                    from <code>label</code>. Dots inside the code (for example
                    <code>"1.2.3"</code>) help establish parent/child
                    relationships. Common properties include:
                  </p>
                  <ul class="orbat-admin__guide-list">
                    <li><code>label</code>: visible title for the unit (required).</li>
                    <li><code>description</code>: optional body text.</li>
                    <li>
                      <code>theme</code>: optional styling token (e.g.
                      <code>"company"</code>, <code>"platoon"</code>).
                    </li>
                    <li>
                      <code>badge</code> and <code>icon</code>: image paths or
                      URLs. Relative paths resolve to this plugin's
                      <code>public/images</code> directory.
                    </li>
                    <li>
                      <code>badgeWidth</code> and <code>labelFontSize</code>:
                      numeric pixel values.
                    </li>
                    <li>
                      <code>select</code>: resolves users. Use
                      <code>any</code>, <code>all</code>, <code>not</code>,
                      <code>limit</code>, <code>includeHidden</code>, and
                      <code>placeholder</code>. Group names must match
                      Discourse group names.
                    </li>
                    <li>
                      <code>children</code>: array of nested nodes using the same
                      structure.
                    </li>
                    <li>
                      <code>alwaysShow</code> or <code>hideNode</code> to force
                      visibility or suppress the card while leaving connectors.
                    </li>
                  </ul>
                  <p>
                    Ordering is fixed: members are listed by the order of group
                    names in <code>select.any</code>/<code>select.all</code> for
                    that node, then by <code>rankPriority</code>, then by join
                    date (manual 16AA Join Date if set, otherwise forum join
                    date), then alphabetically. Place IC/2IC groups early in
                    <code>select.any</code>. Sorting cannot be overridden per
                    node.
                  </p>
                  <p>
                    <code>layout</code> on nodes is accepted and preserved in the
                    JSON output, but the default ORBAT UI does not currently use
                    it.
                  </p>

